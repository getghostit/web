# Copy to .env and fill in real values. Both are build-time only — the site is a static
# build, so changing them requires a rebuild/redeploy. The same two variables must also be
# set in the Cloudflare Pages project settings for getghostit.com.

# Basin form ID — the trailing segment of your form endpoint, https://usebasin.com/f/<id>.
# Found in the Basin dashboard: https://usebasin.com/
BASIN_FORM_ID=

# Cloudflare Turnstile *production* site key, from the Cloudflare dashboard.
# Do not ship the always-passes test key (1x00000000000000000000AA) — it disables spam protection.
TURNSTILE_SITEKEY=
