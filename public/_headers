# Cloudflare Pages headers file. Copied verbatim into dist/ by Astro.
#
# The main Content-Security-Policy is generated by Astro and delivered as a <meta> tag
# (see `security.csp` in astro.config.mjs). `frame-ancestors` is ignored in meta-delivered
# CSP, so it has to be sent as a real header here — without it the site is framable.

/*
  # `preload` is deliberately omitted: submitting to the HSTS preload list is effectively
  # irreversible and commits every current and future subdomain to HTTPS. Add it only once
  # you're sure of that.
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()
  # allow-popups rather than plain same-origin so Cloudflare Turnstile's challenge flow,
  # which can open a popup, keeps working on the contact page.
  Cross-Origin-Opener-Policy: same-origin-allow-popups
