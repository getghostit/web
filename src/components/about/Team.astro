---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import GroupIcon from '@assets/icons/group-line.svg';
import LinkedInIcon from '@assets/icons/linkedin-box-fill.svg';
import { getGlobImage } from '@utils/image';
import { getLabels } from '@i18n/utils';

const labels = getLabels(Astro.currentLocale, 'aboutTeam');
const members = labels.members;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/team-*.{webp,png,jpg,jpeg}');

// Photos are optional and may be any supported format, so match on the `team-N.` prefix.
const photoKeys = members.map((_, index) => Object.keys(images).find((key) => key.startsWith(`/src/assets/team-${index + 1}.`)));
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="space-y-8 sm:space-y-12">
      <div class="flex gap-4">
        <GroupIcon class="fill-primary-500 h-8 w-8 shrink-0 sm:h-10 sm:w-10" aria-hidden="true" />
        <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">{labels.title}</h2>
      </div>
      <ul role="list" class="mx-auto grid max-w-3xl grid-cols-1 gap-8 sm:grid-cols-2">
        {
          members.map((member, index) => (
            <li class="border-subtle rounded-3xl border px-6 py-8">
              <div class="space-y-6">
                {photoKeys[index] ? (
                  <Image
                    class="mx-auto h-40 w-40 rounded-full object-cover"
                    src={getGlobImage(images, photoKeys[index])}
                    alt={member.name}
                    width={320}
                    height={320}
                  />
                ) : (
                  <div
                    class="bg-surface border-subtle mx-auto flex h-40 w-40 items-center justify-center rounded-full border text-4xl font-medium"
                    aria-hidden="true"
                  >
                    {member.name.charAt(0)}
                  </div>
                )}
                <div class="space-y-3 text-center">
                  <div>
                    <h3 class="text-lg font-medium">{member.name}</h3>
                    <p class="text-muted text-base">{member.job}</p>
                  </div>
                  <a
                    href={member.linkedin}
                    class="text-link inline-flex items-center gap-1.5"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <LinkedInIcon class="h-5 w-5" aria-hidden="true" />
                    <span class="sr-only">{`${member.name} on `}</span>LinkedIn
                  </a>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
